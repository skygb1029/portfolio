{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "pnpm install",
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/:section(product|articles)/:slug(parenting-assistant|life-manager|sales-assistant)", "destination": "/product/stock-secretary", "permanent": false },
    { "source": "/app/parenting", "destination": "/product/stock-secretary", "permanent": false },
    { "source": "/demo", "destination": "/app/stock", "permanent": false }
  ],
  "headers": [{
    "source": "/project-demos/(.*)",
    "headers": [
      { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; media-src 'self' blob:; worker-src 'self' blob:; connect-src 'none'; form-action 'none'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'" },
      { "key": "Referrer-Policy", "value": "no-referrer" },
      { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
    ]
  }, {
    "source": "/(admin/.*|demo|works/[^/]+/demo|_seo/.*)",
    "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }]
  }],
  "rewrites": [
    { "source": "/:page(resume|contact|privacy|works|products|articles)", "destination": "/_seo/:page.html" },
    { "source": "/:section(works|product|articles)/:slug", "destination": "/_seo/:section/:slug.html" },
    { "source": "/((?!api/|_vercel/|_seo/).*)", "destination": "/index.html" }
  ]
}
